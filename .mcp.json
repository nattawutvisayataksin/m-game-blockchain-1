{
  "mcpServers": {
    "pixelart-local": {
      "command": "C:/Users/Administrator/AppData/Roaming/Python/Python314/Scripts/uv.exe",
      "args": ["--directory", "${workspaceFolder}/game-dev/mcp-servers/pixelart-mcp", "run", "-m", "pixelart_mcp"]
    },
    "godot-local": {
      "command": "node",
      "args": ["${workspaceFolder}/game-dev/mcp-servers/godot-mcp/build/index.js"],
      "env": { "DEBUG": "true" }
    },
    "godot-full-local": {
      "command": "node",
      "args": ["${workspaceFolder}/game-dev/mcp-servers/godot-mcp-tugcan/build/index.js"],
      "env": { "DEBUG": "true" }
    }
  }
}
