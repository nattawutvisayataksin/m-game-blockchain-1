{
  "name": "m-game-blockchain",
  "version": "0.1.0",
  "private": true,
  "description": "2D Turn-based RPG (Web2-first, Kub Chain/EVM-ready) — Next.js + Prisma + PostgreSQL",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "audit:ledger": "tsx scripts/audit-ledger.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "jose": "^6.0.11",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "prisma": "^6.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
