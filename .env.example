# ============================================================
# M-Game Blockchain — Environment Variables
# cp .env.example .env  แล้วแก้ค่าก่อนรันจริง
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game?schema=public"

# --- Auth (Web2) ---
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Google OAuth (ใส่ค่าเมื่อพร้อมเปิดใช้ ปล่อยว่างระบบจะคืน 501)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Economy ---
# โบนัสตอนสมัครใหม่ (GOLD) — เดินเข้า Ledger แบบ double-entry ทันที
SIGNUP_BONUS_GOLD="500"

# ============================================================
# --- Web3 (Kub Chain / EVM) — Phase B/C : ปล่อยค่าเดิมตอนนี้ ---
# ============================================================

# Adapter สำหรับตรวจสิทธิ์ทรัพย์สิน: "db" (Web2) หรือ "chain" (อ่าน on-chain)
ASSET_OWNERSHIP_PROVIDER="db"

# เกตเปิด Bridge จริง — false = โคด bridge/web3 ทุก endpoint จะคืน 503
WEB3_BRIDGE_ENABLED="false"

# KUB Testnet (chainId 25925) — แนะนำให้ทดสอบบน testnet หลัง Phase C เริ่มต้น
KUB_CHAIN_ID="25925"
KUB_CHAIN_RPC_URL="https://rpc-testnet.kubchain.io"
KUB_CHAIN_EXPLORER_URL="https://testnet.kubscan.com"

# Contract address ที่จะ deploy ใน Phase C (เว้นว่างไว้ก่อน)
GAME_TOKEN_CONTRACT_ADDRESS=""
NFT_COLLECTION_CONTRACT_ADDRESS=""
